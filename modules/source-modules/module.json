{
  "schemaVersion": 2,
  "id": "source-modules",
  "name": "Source Modules",
  "version": "1.0.2",
  "description": "Preserved Streamer.bot scene routing for installed module overlays.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "configurationRequired": false,
  "provides": [
    "source-modules"
  ],
  "web": {
    "root": "web"
  },
  "streamerbot": {
    "requiredActions": [
      "Module Routing - Engine",
      "Module Routing - Initialize",
      "Module Routing - Save",
      "Module Routing - Scene Changed"
    ],
    "importFile": "streamerbot/source-modules.sb"
  },
  "ui": {
    "id": "source-modules",
    "name": "Source Modules",
    "category": "System",
    "order": 90,
    "dockPage": "/routing/index.html",
    "transport": {
      "feature": "moduleRouting",
      "stateKey": "portable.moduleRouting.state",
      "actionPrefix": "Module Routing"
    },
    "actions": [
      "Module Routing - Save",
      "Module Routing - Initialize"
    ],
    "tests": [
      {
        "id": "routing-state",
        "name": "Routing state",
        "level": "safe",
        "fields": [],
        "buttons": [
          {
            "label": "Read routing state",
            "readFeature": "moduleRouting"
          }
        ]
      }
    ],
    "phoneDeck": {
      "schemaVersion": 1,
      "owner": {
        "transport": "streamerbot"
      },
      "actions": {
        "set-mode": {
          "id": "4c66314c-f6d0-4dbf-b2eb-ba57c2651a04",
          "args": {
            "moduleRoutingMode": "set-mode",
            "moduleRoutingTarget": {
              "field": "module"
            },
            "moduleRoutingVisibility": {
              "field": "mode"
            }
          }
        }
      },
      "state": {
        "global": "portable.moduleRouting.state",
        "fields": {
          "phoneDeckVersion": "payload.phoneDeckVersion"
        },
        "ack": {
          "path": "payload.phoneDeckResults",
          "requestId": "$key",
          "status": "status"
        }
      },
      "resources": {
        "modules": {
          "path": "payload.modules",
          "id": "$key",
          "label": "$key"
        },
        "modes": {
          "source": "static",
          "items": [
            {
              "id": "disabled",
              "label": "Hidden"
            },
            {
              "id": "global",
              "label": "All scenes"
            },
            {
              "id": "scenes",
              "label": "Selected saved scenes"
            }
          ]
        }
      },
      "controls": [
        {
          "id": "set-mode",
          "name": "Set saved overlay visibility",
          "kind": "button",
          "action": "set-mode",
          "prerequisites": [
            {
              "field": "phoneDeckVersion",
              "equals": 1
            }
          ],
          "fields": [
            {
              "id": "module",
              "label": "Saved overlay rule",
              "type": "resource",
              "resource": "modules",
              "required": true
            },
            {
              "id": "mode",
              "label": "Visibility",
              "type": "resource",
              "resource": "modes",
              "required": true
            }
          ]
        }
      ]
    }
  },
  "dependencies": {
    "modules": {
      "universal-dock": "^1.0.0"
    },
    "optionalModules": {},
    "capabilities": {},
    "companion": ">=1.3.1"
  }
}
