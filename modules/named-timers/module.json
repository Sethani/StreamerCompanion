{
  "schemaVersion": 2,
  "id": "named-timers",
  "name": "Named Timers",
  "version": "1.0.1",
  "description": "Named and queued language timers using the established Streamer.bot globals, chat command and transparent overlay.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "configurationRequired": false,
  "streamerbot": {
    "requiredActions": [
      "Named Timers - Engine",
      "Named Timers - Initialize",
      "Named Timers - Health",
      "Timer_Add",
      "Timer_Check",
      "Timer_Command",
      "Timers - Publish Overlay State",
      "Named Timers - Queue Language",
      "Named Timers - Check Languages",
      "Named Timers - Language Trigger Adapter"
    ],
    "importFile": "streamerbot/named-timers.sb"
  },
  "dependencies": {
    "modules": {
      "chat-routing": "^1.0.1",
      "universal-dock": "^1.1.0"
    },
    "optionalModules": {
      "source-modules": "^1.0.0",
      "universal-overlay": "^1.0.0"
    },
    "capabilities": {},
    "companion": ">=1.3.1"
  },
  "web": {
    "root": "web",
    "overlayPage": "/overlay/index.html"
  },
  "ui": {
    "id": "timers",
    "name": "Named Timers",
    "category": "Activities",
    "order": 30,
    "dockPage": "/timers/index.html",
    "ownership": "streamerbot",
    "packagedOverlay": true,
    "overlays": [
      "timers"
    ],
    "actions": [
      "Named Timers - Initialize",
      "Named Timers - Health",
      "Timer_Add",
      "Timer_Check",
      "Timer_Command",
      "Timers - Publish Overlay State",
      "Named Timers - Queue Language",
      "Named Timers - Check Languages"
    ],
    "dependencies": [
      "chat-routing",
      "universal-dock",
      "streamerbot-websocket"
    ],
    "optionalDependencies": [
      "source-modules",
      "universal-overlay"
    ],
    "settings": [
      "command",
      "timerSeconds",
      "timerTitle",
      "languageQueue"
    ],
    "tests": [
      {
        "id": "health",
        "name": "Named timer state",
        "level": "safe",
        "fields": [],
        "buttons": [
          {
            "label": "Republish saved timers",
            "feature": "timers",
            "command": "Health",
            "args": {}
          }
        ]
      }
    ],
    "transport": {
      "feature": "timers",
      "stateKey": "portable.timers.state",
      "actionPrefix": "Named Timers"
    },
    "phoneDeck": {
      "schemaVersion": 1,
      "owner": {
        "transport": "streamerbot"
      },
      "state": {
        "global": "portable.timers.state",
        "fields": {
          "phoneDeckVersion": "payload.phoneDeckVersion",
          "activeCount": "payload.phoneDeck.activeCount",
          "summary": "payload.phoneDeck.summary"
        },
        "ack": {
          "path": "payload.phoneDeckResults",
          "requestId": "$key",
          "status": "status"
        }
      },
      "actions": {
        "create": {
          "id": "64f06ada-2dd9-49d6-8af0-e2b31c67fd75",
          "args": {
            "namedTimersMode": "phone-add",
            "timerTitle": {
              "field": "title"
            },
            "timerSeconds": {
              "field": "seconds"
            }
          }
        }
      },
      "controls": [
        {
          "id": "create",
          "name": "Create or extend named timer",
          "kind": "form",
          "action": "create",
          "prerequisites": [
            {
              "field": "phoneDeckVersion",
              "equals": 1
            }
          ],
          "fields": [
            {
              "id": "title",
              "label": "Timer name",
              "type": "text",
              "required": true,
              "maxLength": 80,
              "input": true
            },
            {
              "id": "seconds",
              "label": "Seconds (up to 7 days)",
              "type": "number",
              "input": true,
              "required": true,
              "integer": true,
              "min": 1,
              "max": 604800
            }
          ]
        },
        {
          "id": "status",
          "name": "Named timer status",
          "kind": "widget",
          "display": [
            "activeCount",
            "summary"
          ],
          "displayLabels": {
            "activeCount": "Active timers",
            "summary": "Remaining at last update"
          },
          "fields": []
        }
      ]
    }
  }
}
