{
  "schemaVersion": 2,
  "id": "stream-launch",
  "name": "Stream Launch",
  "version": "1.0.1",
  "description": "Guarded stream startup, Countdown integration, Spotify fades and existing private follow-up actions.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "streamerbot": {
    "requiredActions": [
      "Stream - Launch Engine",
      "Stream - Configure Launch",
      "Stream - Launch",
      "Stream - Online Fallback",
      "Stream - Initialize Launch",
      "Stream - Launch Health"
    ],
    "importFile": "streamerbot/stream-launch.sb"
  },
  "dependencies": {
    "modules": {
      "countdown": "^1.1.0",
      "universal-dock": "^1.0.0"
    },
    "optionalModules": {
      "spotify": "^2.0.1"
    },
    "capabilities": {},
    "companion": ">=1.3.0"
  },
  "web": {
    "root": "web"
  },
  "ui": {
    "id": "stream-launch",
    "name": "Stream Launch",
    "category": "Stream",
    "order": 11,
    "dockPage": "/launch/index.html",
    "ownership": "streamerbot",
    "overlays": [],
    "actions": [
      "Stream - Configure Launch",
      "Stream - Launch",
      "Stream - Initialize Launch",
      "Stream - Launch Health"
    ],
    "dependencies": [
      "universal-dock",
      "countdown",
      "streamerbot-websocket"
    ],
    "optionalDependencies": [
      "spotify",
      "private-followup-action"
    ],
    "settings": [
      "duration",
      "finishedText",
      "startingSoonScene",
      "enabled",
      "fallbackEnabled",
      "spotifyEnabled",
      "followupEnabled",
      "followupAction"
    ],
    "tests": [
      {
        "id": "preflight",
        "name": "Launch readiness (no stream or announcement)",
        "level": "safe",
        "fields": [],
        "buttons": [
          {
            "label": "Check readiness",
            "feature": "streamLaunch",
            "command": "Launch Health",
            "args": {}
          }
        ]
      }
    ],
    "transport": {
      "feature": "streamLaunch",
      "stateKey": "portable.streamLaunch.state",
      "actionPrefix": "Stream"
    },
    "phoneDeck": {
      "schemaVersion": 1,
      "owner": {
        "transport": "streamerbot"
      },
      "actions": {
        "go-live": {
          "id": "be4b86a3-0d20-4664-bb2a-d7aa04c4ca8d",
          "args": {}
        }
      },
      "state": {
        "global": "portable.streamLaunch.state",
        "fields": {
          "status": "payload.status",
          "enabled": "payload.config.enabled",
          "spotify": "payload.spotify",
          "followup": "payload.followup",
          "error": "payload.error"
        }
      },
      "controls": [
        {
          "id": "go-live",
          "name": "Go live (guided)",
          "kind": "button",
          "action": "go-live",
          "confirm": true,
          "hold": true,
          "prerequisites": [
            {
              "field": "enabled",
              "equals": true
            },
            {
              "field": "status",
              "notEquals": "starting"
            }
          ],
          "fields": []
        },
        {
          "id": "progress",
          "name": "Launch progress",
          "kind": "widget",
          "display": [
            "status",
            "spotify",
            "followup",
            "error"
          ],
          "displayLabels": {
            "status": "Launch",
            "spotify": "Music",
            "followup": "Follow-up",
            "error": "Details"
          },
          "fields": []
        }
      ]
    }
  }
}
