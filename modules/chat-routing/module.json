{
  "schemaVersion": 2,
  "id": "chat-routing",
  "name": "Chat Routing",
  "version": "1.0.2",
  "description": "Shared bot-account chat and reply routing for installed Streamer.bot modules.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "configurationRequired": false,
  "provides": [
    "chat-routing"
  ],
  "streamerbot": {
    "requiredActions": [
      "Chat - All Platforms",
      "Chat - Twitch",
      "Chat - Engine",
      "Chat - Twitch Send"
    ],
    "importFile": "streamerbot/chat-routing.sb"
  },
  "dependencies": {
    "modules": {},
    "optionalModules": {},
    "capabilities": {},
    "companion": ">=1.2.2"
  },
  "ui": {
    "id": "chat-routing",
    "name": "Chat Routing",
    "category": "Chat",
    "order": 1,
    "ownership": "streamerbot",
    "overlays": [],
    "actions": [],
    "dependencies": [
      "streamerbot-websocket"
    ],
    "optionalDependencies": [],
    "settings": [],
    "tests": [],
    "phoneDeck": {
      "schemaVersion": 1,
      "owner": {
        "transport": "streamerbot"
      },
      "actions": {
        "send": {
          "id": "dcac5dec-c796-4b8b-9cb6-4271ef4c2f53",
          "args": {
            "chatMessage": {
              "field": "message"
            },
            "chatTargets": "twitch",
            "chatIsReply": false,
            "chatReplyId": ""
          }
        }
      },
      "controls": [
        {
          "id": "bot-message",
          "name": "Send bot message",
          "kind": "form",
          "action": "send",
          "fields": [
            {
              "id": "message",
              "label": "Bot message",
              "type": "text",
              "input": true,
              "required": true,
              "maxLength": 500
            }
          ]
        }
      ]
    }
  }
}
