{
  "schemaVersion": 2,
  "id": "reminders",
  "name": "Reminders",
  "version": "1.0.1",
  "description": "Private viewer reminder backlogs with chat commands and dock-only management.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "configurationRequired": false,
  "streamerbot": {
    "requiredActions": [
      "Reminders - Engine",
      "Reminders - Initialize",
      "Reminders - Health",
      "Reminders - Add",
      "Reminders - List Mine",
      "Reminders - Complete",
      "Reminders - Restore",
      "Reminders - Delete"
    ],
    "importFile": "streamerbot/reminders.sb"
  },
  "dependencies": {
    "modules": {
      "chat-routing": "^1.0.1",
      "universal-dock": "^1.1.0"
    },
    "optionalModules": {},
    "capabilities": {},
    "companion": ">=1.3.0"
  },
  "web": {
    "root": "web"
  },
  "ui": {
    "id": "reminders",
    "name": "Reminders",
    "category": "People",
    "order": 40,
    "dockPage": "/reminders/index.html",
    "ownership": "streamerbot",
    "overlays": [],
    "actions": [
      "Reminders - Initialize",
      "Reminders - Health",
      "Reminders - Add",
      "Reminders - List Mine",
      "Reminders - Complete",
      "Reminders - Restore",
      "Reminders - Delete"
    ],
    "dependencies": [
      "chat-routing",
      "universal-dock",
      "streamerbot-websocket"
    ],
    "optionalDependencies": [],
    "settings": [
      "maximumPerTarget",
      "messageLength"
    ],
    "tests": [
      {
        "id": "health",
        "name": "Reminder state (no messages or display changes)",
        "level": "safe",
        "fields": [],
        "buttons": [
          {
            "label": "Check state",
            "feature": "reminders",
            "command": "Health",
            "args": {}
          }
        ]
      }
    ],
    "transport": {
      "feature": "reminders",
      "stateKey": "portable.reminders.state",
      "actionPrefix": "Reminders"
    }
  }
}
