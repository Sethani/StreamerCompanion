{
  "schemaVersion": 2,
  "id": "audio-routing",
  "name": "Audio Routing",
  "version": "2.0.1",
  "description": "Existing OBS live/VOD track classifications, explicit Save/Apply and game-audio toggle.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "configurationRequired": false,
  "streamerbot": {
    "requiredActions": [
      "Audio Routing - Engine",
      "Audio Routing - Initialize",
      "Audio Routing - Refresh",
      "Audio Routing - Save",
      "Audio Routing - Apply",
      "Audio Routing - Toggle"
    ],
    "importFile": "streamerbot/audio-routing.sb"
  },
  "dependencies": {
    "modules": {
      "universal-dock": "^1.1.1"
    },
    "optionalModules": {},
    "capabilities": {},
    "companion": ">=1.3.1"
  },
  "web": {
    "root": "web"
  },
  "ui": {
    "phoneDeck": {
      "schemaVersion": 1,
      "owner": {
        "transport": "streamerbot"
      },
      "actions": {
        "toggle": {
          "id": "3a540bdc-8a8a-4353-b9b4-d7f0ec78f5dc",
          "args": {}
        }
      },
      "state": {
        "global": "portable.audioRouting.state",
        "fields": {
          "gameAudioVodSafe": "payload.config.gameAudioVodSafe",
          "obsAvailable": "payload.obsAvailable",
          "status": "payload.operation.status",
          "error": "payload.operation.error"
        },
        "ack": {
          "path": "payload.operation",
          "requestId": "requestId",
          "status": "status"
        }
      },
      "controls": [
        {
          "id": "toggle",
          "name": "Toggle game audio VOD",
          "kind": "button",
          "action": "toggle",
          "active": "gameAudioVodSafe",
          "prerequisites": [
            {
              "field": "obsAvailable",
              "equals": true
            }
          ],
          "fields": []
        },
        {
          "id": "status",
          "name": "Audio routing status",
          "kind": "widget",
          "display": [
            "gameAudioVodSafe",
            "obsAvailable",
            "status",
            "error"
          ],
          "displayLabels": {
            "gameAudioVodSafe": "Game VOD",
            "obsAvailable": "OBS",
            "status": "Routing",
            "error": "Details"
          },
          "fields": []
        }
      ]
    },
    "id": "audio-routing",
    "name": "Audio",
    "category": "Stream",
    "order": 30,
    "dockPage": "/audio/index.html",
    "ownership": "streamerbot",
    "overlays": [],
    "actions": [
      "Audio Routing - Engine",
      "Audio Routing - Initialize",
      "Audio Routing - Refresh",
      "Audio Routing - Save",
      "Audio Routing - Apply",
      "Audio Routing - Toggle"
    ],
    "dependencies": [
      "streamerbot-websocket",
      "obs-websocket"
    ],
    "optionalDependencies": [],
    "settings": [
      "sourceRouting",
      "gameAudioVodSafe"
    ],
    "tests": [],
    "transport": {
      "feature": "audioRouting",
      "stateKey": "portable.audioRouting.state",
      "actionPrefix": "Audio Routing"
    }
  }
}
