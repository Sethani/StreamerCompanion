{
  "schemaVersion": 2,
  "id": "controller-input",
  "name": "Controller",
  "version": "1.1.1",
  "description": "Native controller input and the existing gamepad display in the combined stream overlay.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "streamerbot": {
    "requiredActions": []
  },
  "dependencies": {
    "modules": {
      "universal-dock": "^1.0.0"
    },
    "optionalModules": {
      "universal-overlay": "^1.0.0",
      "source-modules": "^1.0.0"
    },
    "capabilities": {
      "windows": "required",
      "powershell": "required",
      "embedded-node": "required"
    },
    "companion": ">=1.3.1"
  },
  "service": {
    "apiVersion": 1,
    "entry": "service/runtime.js",
    "port": 3126,
    "healthPath": "/health",
    "healthService": "controller-input",
    "settingsPath": "/settings",
    "overlayPath": "/overlay",
    "provides": [
      "controller-input"
    ]
  },
  "ui": {
    "id": "controller",
    "name": "Controller",
    "category": "Effects",
    "order": 45,
    "dockPage": "/settings",
    "ownership": "node",
    "packagedOverlay": true,
    "overlays": [
      "controller"
    ],
    "actions": [],
    "dependencies": [
      "universal-dock"
    ],
    "optionalDependencies": [
      "universal-overlay",
      "source-modules"
    ],
    "settings": [
      "enabled",
      "position",
      "size",
      "scale",
      "controllerIndex"
    ],
    "tests": [],
    "phoneDeck": {
      "schemaVersion": 1,
      "owner": {
        "transport": "service",
        "apiPrefix": "/api/controller/",
        "statePath": "/api/controller/phone-deck/state",
        "csrf": {
          "path": "/api/controller/phone-deck/state",
          "field": "csrf",
          "header": "X-Companion-CSRF"
        }
      },
      "state": {
        "fields": {
          "enabled": "enabled",
          "hidden": "hidden",
          "providerStatus": "providerStatus",
          "supported": "supported",
          "controllerConnected": "controllerConnected"
        }
      },
      "actions": {
        "show": {
          "path": "/api/controller/phone-deck/control",
          "method": "POST",
          "args": {
            "command": "show"
          }
        },
        "hide": {
          "path": "/api/controller/phone-deck/control",
          "method": "POST",
          "args": {
            "command": "hide"
          }
        }
      },
      "controls": [
        {
          "id": "show",
          "name": "Show overlay",
          "kind": "button",
          "action": "show",
          "fields": [],
          "active": "enabled"
        },
        {
          "id": "hide",
          "name": "Hide overlay",
          "kind": "button",
          "action": "hide",
          "fields": [],
          "active": "hidden"
        },
        {
          "id": "status",
          "name": "Controller status",
          "kind": "widget",
          "display": [
            "providerStatus",
            "controllerConnected",
            "enabled"
          ],
          "displayLabels": {
            "enabled": "Overlay enabled",
            "providerStatus": "Input status",
            "controllerConnected": "Controller connected"
          },
          "fields": []
        }
      ]
    }
  }
}
