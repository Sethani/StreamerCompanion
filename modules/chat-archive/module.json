{
  "schemaVersion": 2,
  "id": "chat-archive",
  "name": "Chat Archive",
  "version": "1.2.1",
  "description": "Private searchable chat history, retention and CSV/JSON exports from the Live Chatbox feed.",
  "author": "Sethani",
  "license": "MIT",
  "documentation": "README.md",
  "streamerbot": {
    "requiredActions": []
  },
  "dependencies": {
    "modules": {
      "chat-core": "^1.4.1",
      "universal-dock": "^1.1.0"
    },
    "optionalModules": {},
    "capabilities": {
      "embedded-node": "required"
    },
    "companion": ">=1.3.1"
  },
  "service": {
    "apiVersion": 1,
    "entry": "service/runtime.js",
    "port": 3146,
    "healthPath": "/health",
    "healthService": "chat-archive",
    "settingsPath": "/settings",
    "provides": [
      "chat-archive"
    ]
  },
  "ui": {
    "id": "chat-archive",
    "name": "Chat Archive",
