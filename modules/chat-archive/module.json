    "optionalDependencies": [],
    "settings": [
      "enabled",
      "retentionDays",
      "archiveAnnouncements",
      "archiveDeletedText"
    ],
    "tests": [],
    "links": []
  },
  "developerDocumentation": "DEVELOPMENT.md"
}
